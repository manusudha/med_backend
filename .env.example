# ─── Server ────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────
# Your MongoDB connection string (Atlas or local). Put the DB name before the "?".
# e.g. mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/automate_era?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/automate_era

# ─── Auth ──────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ─── SaaS owner key (used to onboard new clinics via /api/platform) ───
# Long random string, keep it private. Leave empty to disable the platform API.
PLATFORM_ADMIN_KEY=

# ─── CORS ──────────────────────────────────────────────
# Comma separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Deployment ────────────────────────────────────────
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx…)
TRUST_PROXY=0
# true = Express also serves the built React app from ../client/dist
SERVE_CLIENT=false
